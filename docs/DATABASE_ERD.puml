@startuml database_erd
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam package {
  BorderColor #90A4AE
  FontName Arial
  FontSize 13
  FontStyle bold
}
skinparam entity {
  BackgroundColor white
  BorderColor #455A64
  FontName Arial
  FontSize 11
  HeaderBackgroundColor #ECEFF1
}

